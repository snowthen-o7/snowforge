{
  "platform": "google-merchant",
  "platform_name": "Google Merchant Center",
  "description": "Severity rules and field definitions for Google Shopping product feeds based on the Google Merchant Center product data specification.",
  "primary_key_candidates": ["id", "item_id", "offer_id"],
  "required_fields": [
    "id",
    "title",
    "description",
    "link",
    "image_link",
    "price",
    "availability",
    "condition",
    "brand"
  ],
  "recommended_fields": [
    "gtin",
    "mpn",
    "google_product_category",
    "product_type",
    "additional_image_link",
    "sale_price",
    "sale_price_effective_date",
    "shipping",
    "shipping_weight",
    "color",
    "size",
    "gender",
    "age_group",
    "item_group_id",
    "custom_label_0",
    "custom_label_1",
    "custom_label_2",
    "custom_label_3",
    "custom_label_4"
  ],
  "critical_rules": [
    {
      "field": "price",
      "condition": "becomes_empty",
      "message": "Price removed -- product will be immediately disapproved in Google Merchant Center"
    },
    {
      "field": "price",
      "condition": "equals_zero",
      "message": "Price dropped to 0 -- critical regression, product cannot serve in Shopping ads"
    },
    {
      "field": "price",
      "condition": "becomes_negative",
      "message": "Price is negative -- invalid value, product will be disapproved"
    },
    {
      "field": "title",
      "condition": "becomes_empty",
      "message": "Title removed -- required field, product will be disapproved"
    },
    {
      "field": "description",
      "condition": "becomes_empty",
      "message": "Description removed -- required field, product will be disapproved"
    },
    {
      "field": "link",
      "condition": "becomes_empty",
      "message": "Product URL removed -- required field, product will be disapproved"
    },
    {
      "field": "image_link",
      "condition": "becomes_empty",
      "message": "Image URL removed -- required field, product will be disapproved"
    },
    {
      "field": "availability",
      "condition": "becomes_empty",
      "message": "Availability removed -- required field, product will be disapproved"
    },
    {
      "field": "availability",
      "condition": "invalid_value",
      "allowed_values": ["in_stock", "out_of_stock", "preorder", "backorder"],
      "message": "Availability has invalid value -- must be one of: in_stock, out_of_stock, preorder, backorder"
    },
    {
      "field": "condition",
      "condition": "invalid_value",
      "allowed_values": ["new", "refurbished", "used"],
      "message": "Condition has invalid value -- must be one of: new, refurbished, used"
    },
    {
      "field": "id",
      "condition": "becomes_empty",
      "message": "Product ID removed -- product cannot be tracked or matched"
    },
    {
      "field": "id",
      "condition": "value_changed",
      "message": "Product ID changed -- this creates a new product in Merchant Center and resets performance history"
    }
  ],
  "high_rules": [
    {
      "field": "gtin",
      "condition": "becomes_empty",
      "message": "GTIN removed -- product will lose significant Shopping impression share"
    },
    {
      "field": "gtin",
      "condition": "length_invalid",
      "valid_lengths": [8, 12, 13, 14],
      "message": "GTIN length is invalid -- must be 8, 12, 13, or 14 digits"
    },
    {
      "field": "brand",
      "condition": "becomes_empty",
      "message": "Brand removed -- required for most products, will cause disapproval"
    },
    {
      "field": "google_product_category",
      "condition": "becomes_empty",
      "message": "Google product category removed -- products will fall back to auto-classification which is less accurate"
    },
    {
      "field": "image_link",
      "condition": "protocol_downgrade",
      "message": "Image URL downgraded from HTTPS to HTTP -- may cause mixed content issues or disapproval"
    },
    {
      "field": "price",
      "condition": "decrease_exceeds_threshold",
      "threshold_percent": 80,
      "message": "Price decreased by more than 80% -- likely a data error, not a real price drop"
    },
    {
      "field": "price",
      "condition": "increase_exceeds_threshold",
      "threshold_percent": 500,
      "message": "Price increased by more than 500% -- likely a data error or currency mismatch"
    },
    {
      "field": "sale_price",
      "condition": "exceeds_price",
      "message": "Sale price is higher than regular price -- will be ignored by Google or cause disapproval"
    },
    {
      "field": "title",
      "condition": "length_exceeds",
      "max_length": 150,
      "message": "Title exceeds 150 characters -- will be truncated in Shopping ads"
    },
    {
      "field": "description",
      "condition": "contains_html",
      "message": "Description contains HTML tags -- Google Merchant Center requires plain text descriptions"
    },
    {
      "field": "shipping_weight",
      "condition": "becomes_empty",
      "message": "Shipping weight removed -- will break carrier-calculated shipping rates"
    },
    {
      "field": "availability",
      "condition": "changed_to_out_of_stock",
      "threshold_percent": 20,
      "message": "More than 20% of products changed to out_of_stock -- verify this is intentional"
    }
  ],
  "field_mappings": {
    "id": ["item_id", "product_id", "offer_id", "sku", "SKU", "ID"],
    "title": ["product_title", "name", "product_name", "item_title", "Title", "Name"],
    "description": ["product_description", "body_html", "desc", "Description", "long_description"],
    "link": ["product_url", "url", "product_link", "URL", "Link", "canonical_url"],
    "image_link": ["image_url", "image", "primary_image", "main_image", "Image URL", "image_src"],
    "additional_image_link": ["additional_images", "gallery_images", "extra_images"],
    "price": ["regular_price", "unit_price", "retail_price", "Price", "list_price"],
    "sale_price": ["special_price", "discount_price", "promo_price", "Sale Price"],
    "availability": ["stock_status", "in_stock", "inventory_status", "Availability"],
    "gtin": ["upc", "ean", "isbn", "barcode", "UPC", "EAN", "GTIN", "Barcode"],
    "mpn": ["manufacturer_part_number", "part_number", "mfr_part_no", "MPN"],
    "brand": ["manufacturer", "vendor", "Brand", "Vendor", "brand_name"],
    "condition": ["product_condition", "item_condition", "Condition"],
    "google_product_category": ["category", "product_category", "google_category", "Category"],
    "product_type": ["category_path", "breadcrumb", "product_category_path", "Type"],
    "color": ["colour", "Color", "Colour", "variant_color"],
    "size": ["product_size", "Size", "variant_size"],
    "gender": ["target_gender", "Gender", "sex"],
    "age_group": ["target_age_group", "age", "Age Group"],
    "item_group_id": ["parent_id", "group_id", "variant_group", "parent_sku"],
    "shipping_weight": ["weight", "product_weight", "Weight", "ship_weight"]
  }
}
